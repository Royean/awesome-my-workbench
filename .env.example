# Local development defaults to loopback, without accounts.
# Production requires HTTPS, enables accounts, and refuses unauthenticated access.
NODE_ENV=production
AUTH_REQUIRED=1
HOST=127.0.0.1
PORT=3180
APP_ORIGIN=https://workbench.example.com
TRUST_PROXY=1
HEALTH_DATA_DIR=/var/lib/awesome-my-workbench
WORKBENCH_BACKUP_DIR=/var/backups/awesome-my-workbench
WORKBENCH_BACKUP_KEEP=7

# Optional. Use a GitHub token with read access to Issues, Pull Requests and
# Checks for the selected repositories. In account mode the token is only used
# for the exact workbench login email configured here.
# WORKBENCH_GITHUB_TOKEN=
# WORKBENCH_GITHUB_ACCOUNT_EMAIL=
# WORKBENCH_GITHUB_LOGIN=
# In account mode, this account sees private role sources and skill references.
# Falls back to WORKBENCH_GITHUB_ACCOUNT_EMAIL.
# WORKBENCH_ROLE_CATALOG_ACCOUNT_EMAIL=
# Optional private JSON role catalog stored outside the source tree.
# WORKBENCH_ROLE_CATALOG_FILE=
