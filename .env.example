# Local development defaults to loopback, without accounts.
# Production requires HTTPS, enables accounts, and refuses unauthenticated access.
NODE_ENV=production
AUTH_REQUIRED=1
HOST=127.0.0.1
PORT=3180
APP_ORIGIN=https://workbench.example.com
# 可选：额外允许访问的精确 https 源（逗号分隔，不含路径），如直连测试域名。仅放宽 Host/Origin 校验；Cookie 仍为 host-only。
# APP_EXTRA_ORIGINS=https://direct.workbench.example.com
TRUST_PROXY=1
HEALTH_DATA_DIR=/var/lib/awesome-my-workbench
WORKBENCH_BACKUP_DIR=/var/backups/awesome-my-workbench
WORKBENCH_BACKUP_KEEP=7
