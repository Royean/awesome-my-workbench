[Unit]
Description=Back up Awesome My Workbench database and attachments
After=awesome-my-workbench.service

[Service]
Type=oneshot
User=aw-workbench
Group=aw-workbench
WorkingDirectory=/opt/awesome-my-workbench/current
EnvironmentFile=/etc/awesome-my-workbench.env
ExecStart=/opt/awesome-my-workbench/node/bin/node scripts/backup.mjs
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/awesome-my-workbench /var/backups/awesome-my-workbench
MemoryMax=128M
