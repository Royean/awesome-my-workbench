# Replace WORKBENCH_DOMAIN and certificate paths before installation.
server {
    listen 80;
    listen [::]:80;
    server_name WORKBENCH_DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/workbench-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name WORKBENCH_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/WORKBENCH_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/WORKBENCH_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    # Compression for public text assets only. Node already serves br/gzip for them (Vary: Accept-Encoding).
    # JSON is excluded and /api/ disables gzip: private health data + compression = BREACH risk.
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_min_length 256;
    gzip_types application/javascript text/javascript text/css application/manifest+json image/svg+xml;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location = /.well-known/assetlinks.json {
        alias /var/www/awesome-my-workbench-download/assetlinks.json;
        default_type application/json;
        add_header Cache-Control "no-store";
    }
    location ^~ /download/ {
        alias /var/www/awesome-my-workbench-download/;
        types { application/vnd.android.package-archive apk; text/plain txt; application/json json; }
        autoindex off;
        add_header Cache-Control "no-store";
        add_header X-Content-Type-Options nosniff always;
    }
    location /api/ {
        gzip off;
        proxy_pass http://127.0.0.1:3180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite untrusted incoming forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
    location / {
        proxy_pass http://127.0.0.1:3180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite untrusted incoming forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
}
