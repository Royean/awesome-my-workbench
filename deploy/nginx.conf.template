# Replace WORKBENCH_DOMAIN and certificate paths before installation.
server {
    listen 80;
    listen [::]:80;
    server_name WORKBENCH_DOMAIN;
    location /.well-known/acme-challenge/ { root /var/www/workbench-acme; }
    location / { return 301 https://$host$request_uri; }
}
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name WORKBENCH_DOMAIN;
    ssl_certificate /etc/letsencrypt/live/WORKBENCH_DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/WORKBENCH_DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 16m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header Strict-Transport-Security "max-age=31536000" always;
    location / {
        proxy_pass http://127.0.0.1:3180;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # Overwrite untrusted incoming forwarding chains.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_hide_header X-Powered-By;
    }
}
